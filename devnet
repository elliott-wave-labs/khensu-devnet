#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# Single-machine khensu.nu network: a gateway, three mixes and two mailboxes,
# each a `tatenan` process on a fixed UDP port, every node on the committee
# that agrees the hourly epoch header.
#
#   ./devnet up [--host <ip>] [--fresh] [--foreground]
#                                         build, generate keys and leases once, sign the genesis
#                                         header with the devnet founder key, start, write devnet.json
#   ./devnet down                         stop all nodes (SIGTERM, mailboxes saved)
#   ./devnet status                       which nodes are running, and what each says over ~node status
#   ./devnet node <name> <~node command>  ask one node (status, peers, receipts, measurements, header, lease, log <filter>, drain)
#   ./devnet logs [node]                  follow logs
#   ./devnet demo                         two khensu-cli clients exchange messages
#   ./devnet test [secs]                  loops through the mixes from a client, header check, node loops and links
set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
tatenan_repo=${TATENAN_REPO:-$root/../khensu-tatenan}
run=$root/run
bin=$tatenan_repo/target/release
# name:port:roles (comma separated; committee is added to every node)
nodes=(gateway-1:47000:gateway,mix mix-1:47001:mix mix-2:47002:mix mix-3:47003:mix mailbox-1:47004:mailbox,mix mailbox-2:47005:mailbox,mix)
# Epochs the first lease covers; the nodes renew their leases themselves.
lease_epochs=${DEVNET_LEASE_EPOCHS:-24}
spare_epochs=${DEVNET_SPARE_EPOCHS:-168}

build() {
    (cd "$tatenan_repo" && cargo build --release -q -p tatenan -p khensu-cli)
}

# Runs a command in its own session so it outlives the calling shell.
detach() {
    if command -v setsid >/dev/null; then
        setsid "$@"
    else
        perl -MPOSIX -e 'POSIX::setsid() or die "setsid"; exec @ARGV or die "exec"' "$@"
    fi
}

pid_alive() {
    [[ -f $1 ]] && kill -0 "$(cat "$1")" 2>/dev/null
}

node_names() {
    local spec
    for spec in "${nodes[@]}"; do echo "${spec%%:*}"; done
}

up() {
    local host=127.0.0.1 fresh=0 foreground=0
    while [[ $# -gt 0 ]]; do
        case $1 in
            --host) host=$2; shift 2 ;;
            --fresh) fresh=1; shift ;;
            --foreground) foreground=1; shift ;;
            *) echo "unknown option $1" >&2; exit 2 ;;
        esac
    done
    if [[ -n $(ls "$run"/pids/*.pid 2>/dev/null) ]]; then
        for p in "$run"/pids/*.pid; do
            if pid_alive "$p"; then echo "devnet is already running; ./devnet down first" >&2; exit 1; fi
        done
    fi
    build
    mkdir -p "$run/pids" "$run/logs"
    [[ $fresh == 1 ]] && rm -rf "$run/nodes" "$run/clients" "$run/founder"
    local listen=127.0.0.1
    [[ $host != 127.0.0.1 ]] && listen=0.0.0.0
    if [[ ! -f $run/founder/founder.key ]]; then
        mkdir -p "$run/founder"
        "$bin/tatenan" founder-keygen --out "$run/founder" >"$run/founder/founder.pub"
    fi
    local leases=() regenerated=0
    for spec in "${nodes[@]}"; do
        IFS=: read -r name port roles <<<"$spec"
        local dir=$run/nodes/$name
        local endpoint=$host:$port
        if [[ ! -f $dir/node.key ]] || [[ ! -f $dir/node.lease ]] || ! grep -qx "$endpoint" "$dir/endpoint" 2>/dev/null; then
            local role_args=()
            local r
            for r in ${roles//,/ } committee; do role_args+=(--role "$r"); done
            rm -rf "$dir/data"
            "$bin/tatenan" keygen --name "$name" "${role_args[@]}" --endpoint "$endpoint" \
                --epochs "$lease_epochs" --spare-epochs "$spare_epochs" --out "$dir" --force >/dev/null
            echo "$endpoint" >"$dir/endpoint"
            regenerated=1
        fi
        cat >"$dir/tatenan.toml" <<EOF
listen = "$listen:$port"
key_file = "node.key"
directory = "../../../devnet.json"
data_dir = "data"

[log]
format = "json"
level = "info"
file = "data/log/tatenan.log"

[lease]
mode = "always_on"
hours = $lease_epochs
EOF
        leases+=("$dir/node.lease")
    done
    if [[ $regenerated == 1 ]] || [[ ! -f $root/devnet.json ]]; then
        # Fresh leases need a fresh genesis; the nodes resume from their own saved headers otherwise.
        for name in $(node_names); do rm -rf "$run/nodes/$name/data/directory.json" "$run/nodes/$name/data/directory.next.json"; done
        "$bin/tatenan" directory --network devnet --founder-key "$run/founder/founder.key" --out "$root/devnet.json" "${leases[@]}"
    fi
    for name in $(node_names); do
        rm -f "$run/pids/$name.pid"
        detach "$bin/tatenan" run --config "$run/nodes/$name/tatenan.toml" --pid-file "$run/pids/$name.pid" \
            </dev/null >>"$run/logs/$name.log" 2>&1 &
    done
    sleep 2
    status
    echo "directory: $root/devnet.json"
    if [[ $foreground == 1 ]]; then
        trap 'down; exit 0' INT TERM
        echo "running in the foreground; Ctrl-C stops the devnet"
        while processes >/dev/null; do sleep 2; done
        for _ in $(seq 60); do
            if [[ -z $(ls "$run"/pids/*.pid 2>/dev/null) ]]; then
                echo "devnet stopped"
                exit 0
            fi
            sleep 0.1
        done
        echo "a node exited; see ./devnet logs" >&2
        down
        exit 1
    fi
}

down() {
    shopt -s nullglob
    local pids=()
    for p in "$run"/pids/*.pid; do
        local pid
        pid=$(cat "$p" 2>/dev/null) || continue
        if kill -TERM "$pid" 2>/dev/null; then
            pids+=("$pid")
        fi
    done
    for _ in $(seq 50); do
        local alive=0
        for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
        [[ $alive == 0 ]] && break
        sleep 0.1
    done
    for pid in "${pids[@]}"; do kill -KILL "$pid" 2>/dev/null || true; done
    rm -f "$run"/pids/*.pid
    echo "devnet stopped"
}

# Which processes are alive; returns 1 if any is down.
processes() {
    local down=0
    for spec in "${nodes[@]}"; do
        IFS=: read -r name port roles <<<"$spec"
        if pid_alive "$run/pids/$name.pid"; then
            printf '%-10s up    udp/%s  pid %-6s %s\n' "$name" "$port" "$(cat "$run/pids/$name.pid")" "$roles,committee"
        else
            printf '%-10s down  udp/%s\n' "$name" "$port"
            down=1
        fi
    done
    return $down
}

# One `~node` command to one node over its control socket.
node() {
    local name=${1:-}
    shift || true
    [[ -z $name ]] && { echo "usage: ./devnet node <name> <~node command>" >&2; exit 2; }
    "$bin/tatenan" shell --socket "$run/nodes/$name/data/control.sock" "$@"
}

status() {
    local rc=0
    processes || rc=1
    echo
    local name
    for name in $(node_names); do
        if pid_alive "$run/pids/$name.pid"; then
            "$bin/tatenan" shell --socket "$run/nodes/$name/data/control.sock" --json status 2>/dev/null \
                | python3 -c '
import json, sys
s = json.load(sys.stdin)
nxt = " next %s" % s["next_header_epoch"] if s.get("next_header_epoch") else ""
mailbox = "  mailbox %s items" % s["mailbox"]["items"] if s.get("mailbox") else ""
print("%-10s epoch %s header %s%s  links %s out %s in  packets %s  loops %s/%s  receipts %s issued %s received%s" % (
    s["name"], s["epoch"], s["header_epoch"], nxt, s["links_out"], s["peers_in"], s["packets"],
    s["loops"]["returned"], s["loops"]["sent"], s["receipts"]["issued"], s["receipts"]["received"], mailbox))' \
                || echo "$name: not answering on its control socket yet"
        fi
    done
    return $rc
}

logs() {
    if [[ $# -gt 0 ]]; then tail -f "$run/logs/$1.log"; else tail -f "$run"/logs/*.log; fi
}

demo() {
    processes >/dev/null || { echo "devnet is not running; ./devnet up first" >&2; exit 1; }
    local c=$run/clients cli=$bin/khensu-cli
    rm -rf "$c" && mkdir -p "$c"
    export KHENSU_DIRECTORY=$root/devnet.json
    "$cli" -s "$c/alice.state" init --name alice
    "$cli" -s "$c/bob.state" init --name bob
    "$cli" -s "$c/bob.state" card --out "$c/bob.card"
    local conv
    conv=$("$cli" -s "$c/alice.state" chat "$c/bob.card")
    "$cli" -s "$c/alice.state" send "$conv" "hello bob" >/dev/null
    echo "alice -> bob in conversation $conv"
    "$cli" -s "$c/bob.state" run --messages 1 --secs 120 </dev/null | tee "$c/bob.out" &
    local bob=$!
    "$cli" -s "$c/alice.state" run --until-sent --secs 120 </dev/null >/dev/null
    wait $bob
    grep -q "hello bob" "$c/bob.out" || { echo "bob did not get the message" >&2; exit 1; }
    "$cli" -s "$c/bob.state" send "$conv" "hi alice" >/dev/null
    echo "bob -> alice"
    "$cli" -s "$c/alice.state" run --messages 1 --secs 120 </dev/null | tee "$c/alice.out" &
    local alice=$!
    "$cli" -s "$c/bob.state" run --until-sent --secs 120 </dev/null >/dev/null
    wait $alice
    grep -q "hi alice" "$c/alice.out" || { echo "alice did not get the reply" >&2; exit 1; }
    echo "demo ok"
}

# Loops from a client, then every node's own loops, links and header.
test_network() {
    local secs=${1:-30}
    processes >/dev/null || { echo "devnet is not running; ./devnet up first" >&2; exit 1; }
    export KHENSU_DIRECTORY=$root/devnet.json
    echo "client loops for ${secs}s"
    "$bin/khensu-cli" net-test --secs "$secs" --loops 100
    local failed=0 name
    for name in $(node_names); do
        local s
        s=$("$bin/tatenan" shell --socket "$run/nodes/$name/data/control.sock" --json status) || { echo "$name: no answer"; failed=1; continue; }
        python3 - "$name" "$s" <<'EOF' || failed=1
import json, sys
name, s = sys.argv[1], json.loads(sys.argv[2])
problems = []
if s["loops"]["sent"] == 0 or s["loops"]["returned"] == 0: problems.append("no node loops came back")
if s["links_out"] == 0 or s["peers_in"] == 0: problems.append("no authenticated links")
if s["header_epoch"] != s["epoch"]: problems.append(f"header epoch {s['header_epoch']} but clock says {s['epoch']}")
if s["undecryptable"] > s["packets"] // 100: problems.append(f"{s['undecryptable']} undecryptable of {s['packets']}")
print(f"{name:<10} loops {s['loops']['returned']}/{s['loops']['sent']} rtt {s['loops']['last_rtt_ms']} ms, links {s['links_out']} out {s['peers_in']} in, header {s['header_epoch']}, committee {'yes' if s['committee'] else 'no'}"
      + ("" if not problems else "  PROBLEM: " + "; ".join(problems)))
sys.exit(1 if problems else 0)
EOF
    done
    [[ $failed == 0 ]] && echo "network test ok" || { echo "network test found problems" >&2; exit 1; }
}

cmd=${1:-}
shift || true
case $cmd in
    up) up "$@" ;;
    down) down ;;
    status) status ;;
    node) node "$@" ;;
    logs) logs "$@" ;;
    demo) demo ;;
    test) test_network "$@" ;;
    *) sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
